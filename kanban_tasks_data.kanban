		{
			"uuid": "60b91666-4274-4fcd-967e-93d7a64ae38f",
			"title": "Renames",
			"description": "Sometimes name clashes occur and it isn't entirely obvious what class does what, which is why i believe it might be beneficial for the long-term to give everything its proper name.\nSure, suffixing all libraries with Lib isn't short, but it might be better? With some exceptions. Convert is definitely intended to be used in specific cases which occur very rarely, but when they occur, Convert is needed extensively, which means one-liners will become less one-liny.",
			"category": "1cc4d8fa-f634-4f2d-baaa-414f6777dc97",
			"steps": [
				{
					"details": "Math -> MathLib",
					"done": false
				},
				{
					"details": "Helper -> HelperLib",
					"done": false
				},
				{
					"details": "Convert -> ConvertLib",
					"done": false
				},
				{
					"details": "Console -> ConsoleLib",
					"done": false
				}
			]
		},
		{
			"uuid": "e5515d91-f4d8-48dd-aa2e-a7fa348a5f4f",
			"title": "Class quality pass",
			"description": "Be it library, component or anything",
			"category": "1cc4d8fa-f634-4f2d-baaa-414f6777dc97",
			"steps": [
				{
					"details": "ensure the test suite is registered in script_order_hook.gd\nUsually checked for automatically by the error in script_order_hook.gd",
					"done": false
				},
				{
					"details": "ensure full test coverage\nEvery property must be covered for initial values.\nEvery method value (data that is logically derived) must be covered for initial values.\nEvery method must have a corresponding test.\nEvery parameter of each method must be covered by tests.",
					"done": false
				},
				{
					"details": "ensure full documentation\nAlso ensure wording and formatting remains consistent with other documentation.",
					"done": false
				},
				{
					"details": "ensure consistency",
					"done": false
				}
			]
		},
